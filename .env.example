# Added automatically by the Neon integration in Vercel.
DATABASE_URL=

# Optional HTML ownership-verification tokens from the search dashboards.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Public AdSense account ID, exactly ca-pub- followed by 16 digits.
# Enables ownership metadata and ads.txt only; does not enable ads or tracking.
# Set in Vercel Production after publisher signup, then rebuild.
ADSENSE_PUBLISHER_ID=

# PostHog public ingestion token (not a personal API key).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
